doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../assets/css/development.css")

  body.development(data-page="development" data-lang="tc")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        section.section-banner.bg-banner
          .banner-photo
            .photo-desktop.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/development/banner-1920X715.jpg")
            .photo-mobile.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/development/banner-mobile-780X550.jpg")
          .banner-title.waypoint
            .title-center
              h6 可持續發展
            .title-bg 
              h6 可持續發展
        // 環境保護
        section.section-story.common-width.center.waypoint
          h6.section-title 可持續發展
          p 我們在推廣可持續發展方面持續成為業界內表現領先的物業管理服務公司。<br>為減少碳排放，我們的團隊從不同層面出發，積極尋求不同方案，提升物業的整體能源使用效益，達致節能減碳。
        // 內文
        section.section-other.common-width
          each val,index in devData
            if (index === 0 || index === 1)
              .article-wrap(id= val.id)
                .photo-wrap.waypoint
                  // 圖片建議尺寸 800X605
                  .photo
                    img.b-lazy(src="../../assets/img/blazy.gif" data-src= val.photo)
                .text-block.waypoint
                  h6.section-title= val.title
                  p !{val.text}
                  // 24/10
                  a.btn-more(href= val.link target="_blank")
                    span 了解更多
                    .circle-right.main
                      div
                  .hide-text 
                    p !{val.hide}
            else
              .article-wrap(id= val.id)
                .photo-wrap.waypoint
                  // 圖片建議尺寸 800X605
                  .photo
                    img.b-lazy(src="../../assets/img/blazy.gif" data-src= val.photo)
                // 24/10
                .text-block.waypoint
                  h6.section-title= val.title
                  p !{val.text}
                  a.btn-more(href= val.link target="_blank")
                    span 了解更多
                    .circle-right.main
                      div
      // breadcrumb
      .breadcrumb
        ul.common-width
          li
            a(href="./index.html")
              span 主頁
          li
            span 可持續發展
      // footer
      include ../layouts/_footer.pug
  //引入的script
  include ../layouts/_script.pug
