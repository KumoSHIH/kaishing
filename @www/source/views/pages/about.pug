doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../assets/css/about.css")

  body.about(data-page="about" data-lang="tc")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        section.section-banner.bg-banner
          .banner-photo
            .photo-desktop.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/about/banner-1920X715.jpg")
            .photo-mobile.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/about/banner-1920X715.jpg")
          .banner-title.waypoint
            .title-center
              h6 關於我們
            .title-bg 
              h6 關於我們
        section.section-icon
          ul.icon-wrap.waypoint
            each val in icon
              li.color-main
                // icon 圖片建議尺寸 200X200 png
                .photo
                  img(src= val.icon, alt="")
                p !{val.text}
        // 我們的故事
        section.section-story.common-width.center.waypoint
          h6.section-title 我們的故事
          p 一切源於一九七八年，新鴻基地產集團在香港成立了啟勝管理服務有限公司（啟勝），讓旗下物業得到專業、優質的物業管理服務。<br>啟勝團隊上下一心、積極進取的精神，令公司不斷壯大，逐步在業界內穩健成長。<br>至今，啟勝負責管理的物業已遍佈香港及內地重要城市，歷年來獲獎無數，在業界內佔有舉足輕重的地位!<br><br>
            <br>近半世紀以來，我們一直秉持母公司「以心建家」的核心價值，陪伴客戶走過不同人生階段，亦慢慢塑造出啟勝獨一無二的品牌價值觀。<br><br>
            <br>優質，就得著重細節；創新，須有破格思維。我們的服務專注且細膩，用心感受客戶每一步；<br>同時，亦與時並進，將創新元素滲透到服務的每一角落。<br><br>
            <br>這就是啟勝!
        // 我們的品牌
        section.section-story.common-width.center.waypoint
          h6.section-title 我們的品牌
          .logo
            img(src="../../assets/img/logo-main.png", alt="")
          p 全新品牌標誌的形態及顏色，重新演繹了啟勝時刻向前的企業精神，以嶄新視覺展示啟勝服務的初心，<br>本著「以心建家」的核心價值，在物業管理服務注入創新元素，為客戶締造美好新生活!<br><br>顏色方面則選用了明亮而穩重的銅黃色，並以同色調的不同層次展示，盡顯品牌穩重低調的個性中，不泛靈活、多變的可能性，<br>整體呈現出專業可靠、具彈性且高雅的品牌氣質。<br>富標誌性的「K」則代表著啟勝，其上揚線條形成箭咀，彰顯了啟勝即使在業界穩紮領導地位，但仍持續求進的服務精神。<br>啟勝期待以可靠而富活力的品牌個性，為客戶實踐專業用心的服務承諾。
        // 業務範圍
        section.section-story.common-width.center.waypoint
          h6.section-title.color-main.pb-3 200+
          p.text-center 管理200+幢物業遍佈香港及中國內地

        // 公司願景
        section.section-idea.common-width.waypoint
          h6.section-title.center 公司願景及使命
          .text
            p 我們的品牌價值觀承載著母公司「以心建家」的核心價值，<br>亦帶著我們著重創新思維，放眼未來的願景。
          ul.icon-wrap.waypoint
            each val in forward
              li.color-dark
                // icon 圖片建議尺寸 200X200 png
                .photo
                  img(src= val.icon, alt="")
                p.en !{val.en}
                p.ch !{val.text}
                p.f !{val.f}
        section.section-swiper.waypoint(style="background-color: #faf7f1")
          .section-wrap.common-width
            .swiper-common
              .swiper-container 
                .swiper-wrapper
                  each val in swiper
                    .swiper-slide
                      .slide-wrap
                        .title-block
                          h6.section-title 我們的理念
                          strong= val.title
                          p= val.text
                        // 圖片建議尺寸 850X560
                        .photo
                          // 24/10修改
                          .photo-wrap
                            img(src= val.photo, alt="")
          .swiper-pagination.horizon
          .swiper-button-prev
            img(src="../../assets/img/arr-left.png", alt="")
          .swiper-button-next
            img(src="../../assets/img/arr-right.png", alt="")
        section.section-brand.common-width.waypoint
          h6 公司旗下品牌
          ul
            each val,index in brand
              li.waypoint
                a(href= val.url)
                  img(src= val.logo, alt="")
        // 影片區
        // 24/10修改
        section.section-videos
          .common-width
            h6 相關影片
            .swiper-videos.swiper-article
              .swiper-container
                .swiper-wrapper
                  // 一個slide 塞三則消息
                  .swiper-slide
                    // mp4 
                    // video-src 影片路徑
                    // video-type= "video"
                    .slide-box
                      .video(video-src="../../assets/img/mp4.mp4"
                        video-type= "video"
                        video-player-type="onBox"
                        video-image= "../../uploads/index/other04-800X605.jpg"
                        data-video)
                      .text
                        h5 mp4. TEST
                        p 需要放一張預設圖片
                    // youtube
                    // video-id: youtube 影片ID
                    // video-image: 預設圖片建議尺寸 615X345
                    .slide-box
                      .video(video-id= "e69jHUyhqZk"
                        video-type="youtubeAPI"
                        video-player-type="onBox"
                        video-image= "../../uploads/index/news01-615X345.jpg"
                        data-video)
                      .text
                        h5 youtube 這是假字
                        p 這是假字，這是假字，這是假字。
                    .slide-box
                      .video(video-src="../../assets/img/mp4.mp4"
                        video-type= "video"
                        video-player-type="onBox"
                        video-image= "../../uploads/index/other04-800X605.jpg"
                        data-video)
                      .text
                        h5 mp4. TEST
                        p 需要放一張預設圖片
                    
                  each val in video
                    // 一個slide 塞三則消息
                    .swiper-slide
                      each slide in val.data
                        .slide-box
                          // video-id: youtube 影片ID
                          // video-image: 預設圖片建議尺寸 615X345
                          .video(video-id= slide.id
                            video-type="youtubeAPI"
                            video-player-type="onBox"
                            video-image= slide.photo
                            data-video)
                          .text
                            // 標題最多一行，超過將出現 ...
                            h5= slide.title
                            // 敘述最多兩行，超過將出現 ...
                            p= slide.desc
              .swiper-tools
                .swiper-button-prev
                .swiper-pagination.horizon
                .swiper-button-next
      // breadcrumb
      .breadcrumb
        ul.common-width
          li
            a(href="./index.html")
              span 主頁
          li
            span 關於我們
      // footer
      include ../layouts/_footer.pug
  //引入的script
  include ../layouts/_script.pug
  <script src="../../assets/js/plugins/video/video-dist.js"></script>
