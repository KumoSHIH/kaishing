doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../assets/css/news.css")

  body.news(data-page="news" data-lang="tc")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        section.normal-banner
          .bg
            .normal-title
              h6 新聞及資源
          p
        // 篩選排序
        .dropdown.common-width
          .d-flex
            .form-select.type-fullbox.mr-1
              .select-head
                p.option 
                  span 年份
                i.icon-keyboard_arrow_down
              .select-content
                ul.scrollbar-inner
                  li 2024
                  li 2023
                  li 2022
                  li 2021
                  li 2020
                  li 2019
                  li 2018
            .form-select.type-fullbox
              .select-head
                p.option 
                  span 月份
                i.icon-keyboard_arrow_down
              .select-content
                ul.scrollbar-inner
                  li 1
                  li 2
                  li 3
                  li 4
                  li 5
                  li 6
                  li 7
                  li 8
                  li 9
                  li 10
                  li 11
                  li 12
            .btn
              .btn-more.border
                span 前往
        // 後端callback: _news.backendCallback();
        .container-fluid.common-width
          .row.info-block-wrap
            each val in info
              .col-12.col-md-6.col-lg-4.mb-4
                .info-block.waypoint
                  .photo
                    .photo-box
                      img.b-lazy(src="../../assets/img/blazy.gif" data-src= val.photo, alt="")
                  .text
                    span.date= val.date
                    //- // 標題超過兩行出現 ...
                    h2= val.title
                    //- // 敘述超過兩行出現 ...
                    //- p !{val.desc}
                    a.btn-more(href= val.link target="_blank") 
                      span 了解更多
                      .circle-right.main
                        div

        // 載入更多按鈕
        .btn.waypoint
          a.btn-more.border(href="javascript:;")
            span 載入更多
      // breadcrumb
      .breadcrumb.waypoint
        ul.common-width
          li
            a(href="./index.html")
              span 主頁
          li
            span 新聞及資源
      // footer
      include ../layouts/_footer.pug
  //引入的script
  include ../layouts/_script.pug
