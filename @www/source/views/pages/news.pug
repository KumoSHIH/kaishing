doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../assets/css/news.css")

  body.news(data-page="news")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        section.normal-banner
          .bg
            .normal-title
              h6 新聞及資源
          p 這是假字，這是假字這是假字。這是假字這是假字這是假字。這是假字，這是假字這是假字。<br><br>這是假字這是假字這是假字。這是假字，這是假字這是假字。這是假字這是假字這是假字。這是假字，這是假字這是假字。<br><br>這是假字這是假字這是假字。這是假字，這是假字這是假字。這是假字這是假字這是假字。
        // 篩選排序
        .dropdown.common-width
          div
            .form-select.type-fullbox
              .select-head
                p.option 
                  span 按日期排序
                i.icon-keyboard_arrow_down
              .select-content
                ul.scrollbar-inner
                  li 2022 9月
                  li 2022 8月 
                  li 2022 7月
                  li 2022 6月
        
        // 後端callback: _news.backendCallback();
        .container-fluid.common-width
          .row
            each val in news
              .col-12.col-md-6.col-lg-4
                .info-block.waypoint
                  .photo
                    .photo-box
                      img.b-lazy(src="../assets/img/blazy.gif" data-src= val.photo, alt="")
                  // 標題超過兩行出現 ...
                  h2= val.title
                  // 敘述超過兩行出現 ...
                  p !{val.desc}
                  a.btn-more(href= val.link target="_blank") 
                    span 了解更多
                    .circle-right.main
                      div

        // 載入更多按鈕
        .btn.waypoint
          a.btn-more.border(href="javascript:;")
            span 載入更多
      // breadcrumb
      .breadcrumb.waypoint
        ul.common-width
          li
            a(href="./index.html")
              span 主頁
          li 
            a(href="javascript:;")
              span 新聞及資源
      // footer
      include ../layouts/_footer.pug
  //引入的script
