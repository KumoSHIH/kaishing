doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../assets/css/property.css")

  body.property(data-page="property" data-lang="tc")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        section.section-banner.bg-banner
          .banner-photo
            .photo-desktop.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/property/banner-desktop.jpg")
            .photo-mobile.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/property/banner-mobile.jpg")
          .banner-title.waypoint
            .title-center
              h6 我們的業務
            .title-bg 
              h6 我們的業務
        // 我們的業務
        section.section-story.common-width.center.waypoint
          h6.section-title 我們的業務
          p 我們的物業管理服務範圍遍佈香港及中國內地，管理的住宅及商業項目多元化，<br>包括辦公大樓、大型購物商場、高級豪宅及大型住宅等，為業戶提供全面、優質的專業物業管理服務。<br><br>在香港，多個國際級商廈及重點物業均由啟勝管理，當中包括環球貿易廣場（ICC）、天際100、九龍貿易中心、新城市廣場、新世紀廣場、<br>新都會廣場、形點、御半山、愛琴海岸及珀麗灣等。同時，旗下的超卓管理服務有限公司亦為多個著名豪宅項目，<br>包括 Park YOHO、爾巒、葡萄園、倚巒、禮頓山、天鑄及 Kennedy 38 等提供酒店式物管服務。<br><br>而早於九十年代初，啟勝更將業務擴展至內地，管理項目覆蓋上海、北京、成都、廣州、深圳和佛山等城市，為內地多個著名地標提供物業管理服務，<br>包括上海國金中心、上海環貿廣場、上海ITC一期、上海ITC二期、上海中環廣場、上海濱江凱旋門、上海名仕苑、上海天薈、蘇州湖滨四季、<br>廣州天環廣場、廣州天匯廣場、佛山南海廣場、北京APM、北京NTP新城廣場、成都環貿廣場及南京國金中心等，足跡遍佈大江南北。

        .property-content
          .content
            .property-text 
              ul
                each val,index in property
                  li(data-target= index+1)
                    .tit 
                      h6= val.title
                      i.icon-circle-down
                    .icon
                      .icon-img
                        img(src= val.icon, alt="")
            .roll-box
              .roll
              .roll-photo
                img(src="../../uploads/property/photo-center.png", alt="")
        .property-swiper
          .swiper-container
            .swiper-wrapper
              each val,index in property
                .swiper-slide(data-target-content= index+1)
                  .slide-box 
                    .photo 
                      .photo-wrap 
                        img(src= val.photo, alt="")
                      h6= val.title 
                      .swiper-button-prev
                      .swiper-button-next
                    .text 
                      h6
                      p
                    

        // 背景色可設定
        section.section-swiper#section-swiper(style="background-color: #faf7f1")
          .section-wrap.common-width
            .swiper-common
              .swiper-container 
                .swiper-wrapper
                  each val,index in swiper
                    // 圖片建議尺寸 850X560
                    .swiper-slide(data-hash=`slider-${index + 1}`)
                      .text
                        //- h6= val.title
                        .img-logo 
                          img(src= val.logo, alt="")
                        p !{val.text}
                      .photo
                        img(src= val.photo, alt="")
          .swiper-pagination.horizon
          .swiper-button-prev
            img(src="../../assets/img/arr-left.png", alt="")
          .swiper-button-next
            img(src="../../assets/img/arr-right.png", alt="")
      // breadcrumb
      .breadcrumb
        ul.common-width
          li
            a(href="./index.html")
              span 主頁
          li
            span 我們的業務
      // footer
      include ../layouts/_footer.pug
  //引入的script
  include ../layouts/_script.pug

