doctype html
html(lang="zh-Hant-HK")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../assets/css/service.css")

  body.service(data-page="service" data-lang="tc")
    .main-wrapper
      // 導覽列
      include ../layouts/_navbar.pug
      // 主要內容
      main
        section.section-banner.bg-banner
          .banner-photo
            .photo-desktop.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/service/banner-1920X715.jpg")
            .photo-mobile.b-lazy(src="../../assets/img/blazy.gif" data-src="../../uploads/service/banner-mobile-780X550.jpg")
          .banner-title.waypoint
            .title-center
              h6 卓越服務
            .title-bg   
              h6 卓越服務
        // 獎項及成就
        section.section-story.common-width.center.waypoint
          h6.section-title 獎項及成就
          p 啟勝在業界內成就卓越，歷年來獲獎無數。<br>憑藉多年專業的服務經驗，我們的團隊用心、創新，策動超越所想的服務，<br>開拓非一般視野，為客戶創造長遠價值，打造理想生活環境。
        // 篩選排序
        .dropdown.common-width
          .d-flex
            .form-select.type-fullbox.mr-1
              .select-head
                p.option 
                  span 年份
                i.icon-keyboard_arrow_down
              .select-content
                ul.scrollbar-inner
                  li 2024
                  li 2023
                  li 2022
                  li 2021
                  li 2020
                  li 2019
                  li 2018
            .form-select.type-fullbox
              .select-head
                p.option 
                  span 月份
                i.icon-keyboard_arrow_down
              .select-content
                ul.scrollbar-inner
                  li 1
                  li 2
                  li 3
                  li 4
                  li 5
                  li 6
                  li 7
                  li 8
                  li 9
                  li 10
                  li 11
                  li 12
            .btn
              .btn-more.border
                span 前往
        section.section-content
          .container-fluid.common-width
            .row.info-block-wrap
              each val in info
                .col-12.col-md-6.col-xl-4.mb-4
                  .info-block.waypoint
                    .photo
                      .photo-box
                        img.b-lazy(src="../../assets/img/blazy.gif" data-src= val.photo, alt="")
                    .text
                      span.date= val.date
                      //- // 標題超過兩行出現 ...
                      h2= val.title
                      //- // 敘述超過兩行出現 ...
                      //- p !{val.desc}
                      a.btn-more(href= val.link target="_blank") 
                        span 了解更多
                        .circle-right.main
                          div
            // 載入更多按鈕
            // 後端callback: _service.backendCallback();
            .btn.waypoint
              a.btn-more.border(href="javascript:;")
                span 載入更多

        // 業界獎項
        section.service-awards.section-story.common-width.center.waypoint
          h6.section-title 業界獎項
          //- p 追求卓越<br>啟勝持續追求革新，為物業管理服務引入嶄新科技，及改進員工的服務質素，<br>以迎合不斷提升的服務需求，打造卓越的服務體驗。

          .container-fluid
            .row
              each val in awards
                .awards-block.col-12.col-md-6.col-xxl-4.d-flex.flex-column.waypoint
                  .top-block.d-flex
                    // 圖片建議尺寸 175X175
                    .photo
                      .photo-wrap
                        img(src= val.photo, alt="")
                    .main
                      h6.fz-18.font-bold.pb-3= val.name
                      span.fz-14 頒發機構
                      h6.pt-2= val.location
                  a.btn-more.pt-4(href="javascript:;")
                    span 了解更多
                    .circle-right.main
                      div
                  //- .bottom-block
                  //-   ul
                  //-     each item in val.list
                  //-       li !{item}
          
          // 載入更多按鈕
          .btn.waypoint.mt-5
            a.btn-more.border(href="javascript:;")
              span 載入更多
        // 專業及認證
        section.service-certified.waypoint
          h6.section-title 專業及認證
          .swiper-service
            .swiper-service-width
              .swiper-container
                .swiper-wrapper
                  each val in certified
                    .swiper-slide
                      .slide-box
                        .photo
                          img(src= val.photo, alt="")
                        p.num= val.number
                        p.text= val.text
            .swiper-button-next
            .swiper-button-prev
      // breadcrumb
      .breadcrumb
        ul.common-width
          li
            a(href="./index.html")
              span 主頁
          li
            span 卓越服務
      // footer
      include ../layouts/_footer.pug
  //引入的script
  include ../layouts/_script.pug
