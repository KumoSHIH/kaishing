header.hd
  .hd-container
    a.logo(href="./index.html")
      img(src="../../assets/img/logo-main.png", alt="")
    .hd-right-wrap
      .hd-right
        .hd-menu
          ul
            each val,index in header
              li(class= val.class)
                a(href= val.url)
                  span= val.ch
                if (index === 2)
                  ul.hd-second
                    each item in val.list
                      li
                        a(href= item.url)= item.name
          .hd-tools.hd-search
            form(action="post") 
              .sch-input
                input(type="text" placeholder="請輸入文字")
              .desktop-search
                input.pointer-none(type="submit")
                i.icon-search
          .hd-tools.hd-lang
            i.icon-globe
            ul
              li.btn-lang(data-btn-lang="en")
                a(href="javascript:;") EN
              li.btn-lang(data-btn-lang="sc")
                a(href="javascript:;") 简
        .hd-other
          .mobile-search
            input(type="text" placeholder="請輸入文字")
            a(href="javascript:;")
              i.icon-search
          ul
            each val,index in other
              li
                a(href= val.url)= val.ch
              //- if(index === 0)
